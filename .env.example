# Database
# PostgreSQL connection URL for Prisma ORM
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/agentbrowse?schema=public"

# Application (Optional)
PORT=3000
NODE_ENV="development"

# Admin Seed Credentials (Used by prisma/seed.ts)
ADMIN_EMAIL="admin@agentbrowse.com"
ADMIN_PASSWORD="your-secure-admin-password"

# Browserbase Cloud Browser Infrastructure
BROWSERBASE_API_KEY="your-browserbase-api-key"
BROWSERBASE_PROJECT_ID=""

# Trigger.dev Background Automation
TRIGGER_SECRET_KEY="tr_dev_..."
TRIGGER_PROJECT_ID=""

# AI Web Agents (Optional - Intelligent simulation active if unset)
GEMINI_API_KEY=""
GROK_API_KEY=""

# Resend Transactional Email Infrastructure (Optional - Simulation active if unset)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
ALERT_EMAIL=""
