generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  workspaceName String?   @default("Personal Workspace")
  activeOrgId   String?
  role          String    @default("customer")
  plan          String    @default("free")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions        Session[]
  workflows       Workflow[]
  memberships     OrganizationMember[]
  sentInvitations OrganizationInvitation[] @relation("SentInvitations")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Organization {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String?
  aiInstructions String?
  defaultAiModel String?   @default("Gemini 2.5 Pro Vision")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  members     OrganizationMember[]
  workflows   Workflow[]
  invitations OrganizationInvitation[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model OrganizationInvitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           String       @default("member")
  token          String       @unique
  status         String       @default("pending")
  invitedById    String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User         @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([email])
}

model Workflow {
  id             String        @id @default(cuid())
  name           String
  description    String?
  category       String        @default("Custom Automation")
  targetUrl      String
  status         String        @default("idle")
  aiModel        String?       @default("Gemini 2.5 Pro Vision")
  sandboxEnv     String?       @default("Chromium 128 (CDP Protocol)")
  nodes          Json
  edges          Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

model NodeTemplate {
  id             String   @id @default(cuid())
  title          String
  category       String
  badge          String
  archetype      String   @default("action")
  description    String
  actionSummary  String
  isPremium      Boolean  @default(false)
  defaultMetrics Json
  defaultLogs    Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
